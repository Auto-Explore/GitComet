+    use super::*;
+    use std::{cell::Cell, rc::Rc, sync::Arc};
+
+    #[test]
+    fn modal_budget_leaves_pending_tasks_and_the_normal_loop_wake_intact() {
+        let (sender, mut receiver) = PriorityQueueReceiver::new();
+        let dispatcher = Arc::new(WindowsDispatcher::new(sender, HWND::default(), 0));
+        let foreground = gpui::ForegroundExecutor::new(dispatcher.clone());
+        let completed = Rc::new(Cell::new(0));
+        for _ in 0..2 {
+            let completed = completed.clone();
+            foreground
+                .spawn(async move {
+                    // One non-preemptible task consumes the modal tick. The next
+                    // task must remain queued so painting/input can get a turn.
+                    std::thread::sleep(MAIN_TASK_BUDGET + Duration::from_millis(1));
+                    completed.set(completed.get() + 1);
+                })
+                .detach();
+        }
+        WindowsDispatcher::drain_modal_tasks(&mut receiver);
+        assert_eq!(completed.get(), 1);
+        assert!(!receiver.is_empty());
+        assert!(dispatcher.wake_posted.load(Ordering::Acquire));
+        WindowsDispatcher::drain_modal_tasks(&mut receiver);
+        assert_eq!(completed.get(), 2);
+        assert!(receiver.is_empty());
+        assert!(dispatcher.wake_posted.load(Ordering::Acquire));
+    }
+}
