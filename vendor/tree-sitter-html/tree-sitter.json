{
  "grammars": [
    {
      "name": "html",
      "camelcase": "HTML",
      "scope": "text.html.basic",
      "path": ".",
      "file-types": [
        "html",
        "htm"
      ]
    }
  ],
  "metadata": {
    "version": "0.23.2",
    "license": "MIT",
    "description": "HTML grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-html"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}