{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "crontab",
  "rules": {
    "file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "comment"
          },
          {
            "type": "SYMBOL",
            "name": "environment"
          },
          {
            "type": "SYMBOL",
            "name": "job"
          },
          {
            "type": "PATTERN",
            "value": "\\r?\\n"
          }
        ]
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "#"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    },
    "environment": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "variable"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "value",
              "content": {
                "type": "SYMBOL",
                "name": "value"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "PATTERN",
          "value": "\\r?\\n"
        }
      ]
    },
    "variable": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_]*"
    },
    "value": {
      "type": "PATTERN",
      "value": "[^\\n]*"
    },
    "job": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "schedule",
          "content": {
            "type": "SYMBOL",
            "name": "schedule"
          }
        },
        {
          "type": "FIELD",
          "name": "command",
          "content": {
            "type": "SYMBOL",
            "name": "command"
          }
        },
        {
          "type": "PATTERN",
          "value": "\\r?\\n"
        }
      ]
    },
    "schedule": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "special"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "field"
            },
            {
              "type": "SYMBOL",
              "name": "field"
            },
            {
              "type": "SYMBOL",
              "name": "field"
            },
            {
              "type": "SYMBOL",
              "name": "field"
            },
            {
              "type": "SYMBOL",
              "name": "field"
            }
          ]
        }
      ]
    },
    "special": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "@"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "reboot"
              },
              {
                "type": "STRING",
                "value": "yearly"
              },
              {
                "type": "STRING",
                "value": "annually"
              },
              {
                "type": "STRING",
                "value": "monthly"
              },
              {
                "type": "STRING",
                "value": "weekly"
              },
              {
                "type": "STRING",
                "value": "daily"
              },
              {
                "type": "STRING",
                "value": "midnight"
              },
              {
                "type": "STRING",
                "value": "hourly"
              }
            ]
          }
        ]
      }
    },
    "field": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_term"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "SYMBOL",
                "name": "_term"
              }
            ]
          }
        }
      ]
    },
    "_term": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "range"
            },
            {
              "type": "SYMBOL",
              "name": "wildcard"
            },
            {
              "type": "SYMBOL",
              "name": "number"
            },
            {
              "type": "SYMBOL",
              "name": "name"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "step"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "range": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "number"
            },
            {
              "type": "SYMBOL",
              "name": "name"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "number"
            },
            {
              "type": "SYMBOL",
              "name": "name"
            }
          ]
        }
      ]
    },
    "wildcard": {
      "type": "STRING",
      "value": "*"
    },
    "step": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "/"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        }
      ]
    },
    "number": {
      "type": "PATTERN",
      "value": "\\d+"
    },
    "name": {
      "type": "PATTERN",
      "value": "[A-Za-z]{3}"
    },
    "command": {
      "type": "PATTERN",
      "value": "[^\\n]+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}