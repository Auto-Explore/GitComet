# Maintainer: AutoExplore Oy <info@autoexplore.ai>
# Generated by scripts/update-aur.sh. Edit this template, not the AUR checkout.
pkgname=gitcomet-bin
pkgver=@PKGVER@
pkgrel=@PKGREL@
_version=@VERSION@
pkgdesc='Fast, resource-efficient Git GUI written in Rust'
arch=('x86_64' 'aarch64')
url='https://gitcomet.dev/'
license=('AGPL-3.0-only')
provides=("gitcomet=$pkgver")
conflicts=('gitcomet')
# Linked libraries from scripts/check-linux-runtime-deps.sh, plus git and icons.
depends=(
  'git'
  'glibc'
  'libgcc'
  'fontconfig'
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'zlib'
  'hicolor-icon-theme'
  # Arch has no either/or dependencies. EGL guarantees a renderer is available;
  # the preferred Vulkan renderer remains optional, as do native Wayland sessions.
  'libglvnd'
)
optdepends=(
  'vulkan-icd-loader: preferred Vulkan renderer (otherwise uses EGL)'
  'wayland: native Wayland sessions (otherwise uses X11)'
  'git-lfs: Git LFS support'
  'gnupg: commit signing and verification'
  'openssh: SSH remotes and commit signing'
  'xdg-utils: open files and links in external applications'
  'xdg-desktop-portal: file pickers and desktop settings'
  'noto-fonts-cjk: CJK font coverage'
  'noto-fonts-emoji: emoji font coverage'
)
options=('!strip' '!debug')
source=("gitcomet-source-v${_version}.tar.gz::https://github.com/Auto-Explore/GitComet/archive/refs/tags/v${_version}.tar.gz")
source_x86_64=("https://github.com/Auto-Explore/GitComet/releases/download/v${_version}/gitcomet-v${_version}-linux-x86_64.tar.gz")
source_aarch64=("https://github.com/Auto-Explore/GitComet/releases/download/v${_version}/gitcomet-v${_version}-linux-arm64.tar.gz")
sha256sums=('@SOURCE_SHA256@')
sha256sums_x86_64=('@X86_64_SHA256@')
sha256sums_aarch64=('@AARCH64_SHA256@')

package() {
  local binary_arch="$CARCH" size
  [[ "$CARCH" != aarch64 ]] || binary_arch=arm64

  install -Dm755 "$srcdir/gitcomet-v${_version}-linux-${binary_arch}/gitcomet" \
    "$pkgdir/usr/bin/gitcomet"
  cd "$srcdir/GitComet-${_version}"
  install -Dm644 assets/linux/gitcomet.desktop "$pkgdir/usr/share/applications/gitcomet.desktop"
  for size in 32 48 128 256 512; do
    install -Dm644 "assets/linux/hicolor/${size}x${size}/apps/gitcomet.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/gitcomet.png"
  done
  install -Dm644 LICENSE-AGPL-3.0 "$pkgdir/usr/share/licenses/$pkgname/LICENSE-AGPL-3.0"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
